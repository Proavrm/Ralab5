# RaLab5 — variables d'environnement
# Copier vers .env ou définir via setx / panneau système Windows.
# Ne jamais committer de secrets réels.

# ── Authentification ──────────────────────────────────────────────
# Modes: passwordless | proxy | access_key
# Défaut launch_ralab5_server.cmd: proxy
RALAB_AUTH_MODE=proxy

# Secret JWT (obligatoire en production, min 32 octets pour HS256)
RALAB_JWT_SECRET=change-me-use-a-long-random-secret

# Forcer auth API/storage indépendamment du mode (1/0, true/false)
# RALAB_REQUIRE_API_AUTH=1
# RALAB_PROTECT_STORAGE=1

# Mode access_key uniquement
# RALAB_ACCESS_KEY=
# RALAB_ACCESS_KEY_ALLOWED_EMAILS=user@example.com,admin@example.com
# RALAB_PRESENTATION_ADMIN_ROLE=admin

# Headers proxy pour identité (mode proxy, CSV)
# RALAB_PROXY_AUTH_HEADERS=CF-Access-Authenticated-User-Email,X-Forwarded-User

# ── CORS / hôtes ──────────────────────────────────────────────────
RALAB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ralab.example.com
RALAB_ALLOWED_HOSTS=localhost,127.0.0.1,ralab.example.com

# ── Bases de données ──────────────────────────────────────────────
# RALAB4_DB_PATH=backend/current_fastapi/data/ralab3.db
# RALAB4_QSSE_DB_PATH=backend/current_fastapi/data/qsse.db

# ── Dossiers métier ───────────────────────────────────────────────
# Mode dossiers: pending | local
# RALAB_DOSSIER_MODE=local
# RALAB_AFFAIRES_ROOT=C:\Users\...\OneDrive - NGE\Labo ARS - Documents\02 - Affaires
# RALAB_DEMANDES_ROOT=C:\Users\...\OneDrive - NGE\Labo ARS - Documents\01 - Demandes
